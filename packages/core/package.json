{
  "name": "agentreview",
  "version": "0.4.2",
  "description": "Core library for AI code review sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./threads": {
      "types": "./dist/threads.d.ts",
      "default": "./dist/threads.js"
    },
    "./anchors": {
      "types": "./dist/anchors.d.ts",
      "default": "./dist/anchors.js"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "default": "./dist/git.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "simple-git": "^3.27.0"
  }
}
