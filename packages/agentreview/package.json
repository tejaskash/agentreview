{
  "name": "agntrev",
  "version": "0.1.0",
  "description": "AI code review CLI and library — review sessions anchored to code regions",
  "type": "module",
  "license": "MIT",
  "author": "Tejas Kashinath ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejaskash/agentreview.git",
    "directory": "packages/agentreview"
  },
  "keywords": [
    "code-review",
    "ai",
    "cli",
    "agent"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "arv": "./dist/cli/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    },
    "./session": {
      "types": "./dist/core/session.d.ts",
      "default": "./dist/core/session.js"
    },
    "./threads": {
      "types": "./dist/core/threads.d.ts",
      "default": "./dist/core/threads.js"
    },
    "./anchors": {
      "types": "./dist/core/anchors.d.ts",
      "default": "./dist/core/anchors.js"
    },
    "./git": {
      "types": "./dist/core/git.d.ts",
      "default": "./dist/core/git.js"
    },
    "./export": {
      "types": "./dist/core/export.d.ts",
      "default": "./dist/core/export.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
