{
  "name": "agentreview-vscode",
  "displayName": "AgentReview (ARV)",
  "description": "AI code review workflow — review threads anchored to code regions",
  "version": "0.1.0",
  "publisher": "agentreview",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejaskash/agentreview.git",
    "directory": "packages/vscode"
  },
  "categories": ["AI", "Chat", "Other"],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.agentreview/session.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arv",
          "title": "AgentReview",
          "icon": "media/icons/arv-activity.svg"
        }
      ]
    },
    "views": {
      "arv": [
        {
          "id": "arvThreads",
          "name": "Threads"
        }
      ]
    },
    "commands": [
      {
        "command": "arv.initSession",
        "title": "ARV: Initialize Review Session"
      },
      {
        "command": "arv.addThread",
        "title": "ARV: Add Thread"
      },
      {
        "command": "arv.exportBundle",
        "title": "ARV: Export for Agent"
      },
      {
        "command": "arv.applyPatch",
        "title": "ARV: Apply Patch"
      },
      {
        "command": "arv.showStatus",
        "title": "ARV: Show Status"
      },
      {
        "command": "arv.openThread",
        "title": "ARV: Open Thread"
      },
      {
        "command": "arv.bulkResolve",
        "title": "ARV: Bulk Resolve Threads"
      },
      {
        "command": "arv.endSession",
        "title": "ARV: End Review Session"
      },
      {
        "command": "arv.installSkill",
        "title": "ARV: Install Claude Code Skill"
      },
      {
        "command": "arv.bulkResolveGroup",
        "title": "Resolve All",
        "icon": "$(pass-filled)"
      },
      {
        "command": "arv.replyComment",
        "title": "Reply",
        "icon": "$(reply)"
      },
      {
        "command": "arv.resolveComment",
        "title": "Resolve Thread",
        "icon": "$(check)"
      },
      {
        "command": "arv.reopenComment",
        "title": "Reopen Thread",
        "icon": "$(issues)"
      },
      {
        "command": "arv.markMustFix",
        "title": "Mark as Must-Fix",
        "icon": "$(flame)"
      },
      {
        "command": "arv.markComment",
        "title": "Mark as Comment",
        "icon": "$(comment)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "arv.addThread",
          "when": "editorHasSelection",
          "group": "arv@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "arv.resolveComment",
          "group": "inline@1",
          "when": "commentController == arv-threads && commentThreadIsEmpty == false"
        },
        {
          "command": "arv.reopenComment",
          "group": "inline@2",
          "when": "commentController == arv-threads && commentThreadIsEmpty == false"
        },
        {
          "command": "arv.markMustFix",
          "group": "inline@3",
          "when": "commentController == arv-threads && commentThread == comment"
        },
        {
          "command": "arv.markComment",
          "group": "inline@4",
          "when": "commentController == arv-threads && commentThread == must-fix"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "arv.replyComment",
          "group": "inline",
          "when": "commentController == arv-threads"
        }
      ],
      "view/item/context": [
        {
          "command": "arv.bulkResolveGroup",
          "when": "view == arvThreads && viewItem == statusGroupResolvable",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arv.addThread",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorHasSelection"
      },
      {
        "command": "arv.bulkResolve",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "arv.showStatus",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "agentreview": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "vitest": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
